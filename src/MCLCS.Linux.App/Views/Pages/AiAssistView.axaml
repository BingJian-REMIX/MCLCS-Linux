<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.AiAssistView"
             x:DataType="vm:AiAssistViewModel">
  <UserControl.Resources>
    <conv:BoolToVisibleConverter x:Key="BoolToVis"/>
  </UserControl.Resources>

  <Grid Margin="18" ColumnDefinitions="140,*">

    <!-- ===== 左侧功能列表 ===== -->
    <ListBox Grid.Column="0" ItemsSource="{Binding Functions}"
             SelectedItem="{Binding SelectedFunction}"
             Background="{DynamicResource ControlBackground}"
             BorderBrush="{DynamicResource ControlBorder}"
             BorderThickness="1" CornerRadius="8">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Height="40" ColumnDefinitions="28,*">
            <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="14"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"
                       VerticalAlignment="Center" Margin="4,0,0,0"
                       Foreground="{DynamicResource PrimaryForeground}"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ===== 右侧内容区（按功能切换） ===== -->
    <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">

        <!-- 崩溃解读 -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowCrash, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="崩溃解读" FontWeight="Bold" FontSize="15"/>
          <TextBox Text="{Binding CrashText}" MinHeight="180" AcceptsReturn="True" TextWrapping="Wrap"
                   Watermark="在此粘贴 crash-report 内容…" FontFamily="Consolas, monospace"
                   Background="{DynamicResource InputBackground}"
                   BorderBrush="{DynamicResource InputBorder}"/>
          <Button Classes="modal-btn accent" Content="解读" Command="{Binding InterpretCommand}"
                  IsEnabled="{Binding !IsBusy}" Width="80" HorizontalAlignment="Left"/>
          <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10">
            <TextBlock Text="{Binding Interpretation}" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryForeground}"/>
          </Border>
        </StackPanel>

        <!-- 推荐理由 -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowRecommend, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="配装推荐 / 推荐理由" FontWeight="Bold" FontSize="15"/>
          <TextBox Text="{Binding RecommendInput}" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                   Watermark="描述你的玩法偏好，AI 会推荐适合的 Mod"
                   Background="{DynamicResource InputBackground}"
                   BorderBrush="{DynamicResource InputBorder}"/>
          <Button Classes="modal-btn accent" Content="推荐" Command="{Binding RecommendCommand}"
                  IsEnabled="{Binding !IsBusy}" Width="80" HorizontalAlignment="Left"/>
          <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10">
            <TextBlock Text="{Binding RecommendOutput}" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryForeground}"/>
          </Border>
        </StackPanel>

        <!-- Mod 翻译 -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowTranslate, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Mod 描述翻译" FontWeight="Bold" FontSize="15"/>
          <TextBox Text="{Binding ModText}" MinHeight="180" AcceptsReturn="True" TextWrapping="Wrap"
                   Watermark="在此粘贴 Mod 的英文描述…"
                   Background="{DynamicResource InputBackground}"
                   BorderBrush="{DynamicResource InputBorder}"/>
          <Button Classes="modal-btn accent" Content="翻译" Command="{Binding TranslateCommand}"
                  IsEnabled="{Binding !IsBusy}" Width="80" HorizontalAlignment="Left"/>
          <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10">
            <TextBlock Text="{Binding Translated}" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryForeground}"/>
          </Border>
        </StackPanel>

        <!-- 年度总结 -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowSummary, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="年度总结" FontWeight="Bold" FontSize="15"/>
          <TextBlock Text="根据你的游玩记录，AI 生成一段年度总结。"
                     Foreground="{DynamicResource SecondaryForeground}"/>
          <Button Classes="modal-btn accent" Content="生成总结" Command="{Binding SummaryCommand}"
                  IsEnabled="{Binding !IsBusy}" Width="100" HorizontalAlignment="Left"/>
          <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10">
            <TextBlock Text="{Binding AnnualSummary}" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryForeground}"/>
          </Border>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Classes="status" Margin="0,4,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
