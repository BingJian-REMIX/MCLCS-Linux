<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.AiChatView"
             x:DataType="vm:AiChatViewModel">
  <UserControl.Resources>
    <conv:BoolToBrushConverter x:Key="BoolToBrush"/>
    <conv:OllamaStatusToTextConverter x:Key="OllamaStatusToText"/>
  </UserControl.Resources>
  <ScrollViewer Margin="18">
    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

      <StackPanel Spacing="8">
        <TextBlock Text="本地 Ollama 服务" FontWeight="Bold" FontSize="14"/>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="{Binding OllamaRunning, Converter={StaticResource BoolToBrush}}"/>
            <TextBlock Text="{Binding OllamaStatus, Converter={StaticResource OllamaStatusToText}}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="modal-btn" Content="检查状态"
                  Command="{Binding CheckStatusCommand}"/>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="粘贴崩溃日志，AI 解读" FontWeight="Bold" FontSize="14"/>
        <TextBox Text="{Binding Input}" AcceptsReturn="True" MinHeight="120" FontFamily="Consolas"
                 Watermark="在此粘贴 crash-report 内容…"/>
        <Button Classes="modal-btn accent" Content="分析" Command="{Binding SendCommand}"
                IsEnabled="{Binding !Busy}" HorizontalAlignment="Left"/>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="分析结果" FontWeight="Bold" FontSize="14"/>
        <TextBlock Text="{Binding Output}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                   Foreground="#B8C0CC"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <ProgressBar IsIndeterminate="{Binding Busy}" IsVisible="{Binding Busy}"/>
        <TextBlock Grid.Column="1" Classes="status" Margin="12,0,0,0" Text="{Binding Status}"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
