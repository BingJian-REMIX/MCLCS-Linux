<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.BackupView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900">
      <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                 Text="{Binding Source='tool.backup', Converter={StaticResource KeyToText}}"/>

      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="刷新" Command="{Binding RefreshCommand}"/>
          <Button Content="执行计划备份" Command="{Binding RunScheduledCommand}" Classes="modal-btn"/>
          <Button Content="清理过期" Command="{Binding PruneCommand}" Classes="modal-btn"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}"/>
        <ListBox x:Name="BackupList" ItemsSource="{Binding Records}" Background="{DynamicResource InputBackground}" MaxHeight="360">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding SourceName}" VerticalAlignment="Center"/>
                  <Border Padding="5,1" CornerRadius="6" Background="{DynamicResource ControlBorder}"
                          IsVisible="{Binding Auto}">
                    <TextBlock Text="自动" FontSize="10" Foreground="{DynamicResource SecondaryForeground}"/>
                  </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11"
                           Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11"
                           Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding CreatedAt}" FontSize="11"
                           Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
                <Button Grid.Column="4" Content="删除" Classes="modal-btn"
                        Command="{Binding #BackupList.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
