<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.DataPackView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                 Text="{Binding Source='tool.datapack', Converter={StaticResource KeyToText}}"/>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}"
                      MinWidth="200" PlaceholderText="选择存档"/>
            <Button Content="刷新存档" Command="{Binding RefreshSavesCommand}"/>
            <Button Content="扫描冲突" Command="{Binding ScanCommand}" Classes="modal-btn primary"/>
          </StackPanel>
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding Packs.Count, Converter={StaticResource CountToVisible}}">
        <StackPanel Spacing="8">
          <TextBlock Text="数据包列表" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
          <ListBox ItemsSource="{Binding Packs}" Background="{DynamicResource InputBackground}" MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding PackFormat, StringFormat='格式 {0}'}"
                             FontSize="11" Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
                  <Border Grid.Column="2" Padding="6,1" CornerRadius="6"
                          Background="{DynamicResource DangerBrush}" IsVisible="{Binding MissingMeta}">
                    <TextBlock Text="缺 meta" FontSize="10" Foreground="#FFFFFF"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding Conflicts.Count, Converter={StaticResource CountToVisible}}">
        <StackPanel Spacing="8">
          <TextBlock Text="冲突" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
          <ListBox ItemsSource="{Binding Conflicts}" Background="{DynamicResource InputBackground}" MaxHeight="260">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="3" Margin="0,4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Padding="6,1" CornerRadius="6"
                            Background="{Binding Severity, Converter={StaticResource ConflictSeverityToBrush}}">
                      <TextBlock Text="{Binding Severity}" FontSize="10" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock Text="{Binding Resource}" FontWeight="Bold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Packs, Converter={StaticResource ListJoin}}"
                             FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                  <TextBlock Text="{Binding Advice}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource SecondaryForeground}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding FormatWarnings.Count, Converter={StaticResource CountToVisible}}">
        <StackPanel Spacing="8">
          <TextBlock Text="格式告警" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
          <ItemsControl ItemsSource="{Binding FormatWarnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,2" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForeground}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
