<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.GameHomeView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="880">

      <!-- 主页 Hero -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Source='tab.game', Converter={StaticResource KeyToText}}"
                     FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
          <TextBlock Text="{Binding Source='home.game.desc', Converter={StaticResource KeyToText}}"
                     Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 快速启动面板 -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="快速启动" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>

          <StackPanel Spacing="10">
            <!-- 版本 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="版本" Width="72" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
              <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                        HorizontalAlignment="Stretch" MinWidth="320">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Display}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- 账户 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="账户" Width="72" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
              <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                        HorizontalAlignment="Stretch" MinWidth="320">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding DisplayName}"/>
                      <TextBlock Text="{Binding AuthType}" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- 内存 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="内存(MB)" Width="72" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
              <NumericUpDown Value="{Binding MemoryMb}" Minimum="512" Maximum="16384"
                             Increment="256" Width="200"/>
            </StackPanel>

            <!-- Java -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Java" Width="72" VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryForeground}"/>
              <ComboBox ItemsSource="{Binding JavaList}" SelectedItem="{Binding SelectedJava}"
                        HorizontalAlignment="Stretch" MinWidth="320">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="启动游戏" Command="{Binding LaunchCommand}"
                      IsEnabled="{Binding CanLaunch}" Classes="modal-btn primary"/>
              <Button Content="刷新版本" Command="{Binding RefreshVersionsCommand}"/>
              <Button Content="扫描 Java" Command="{Binding DetectJavaCommand}"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
