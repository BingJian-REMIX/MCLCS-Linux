<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.LaunchSettingsView"
             x:DataType="vm:LaunchSettingsViewModel">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                     Text="{Binding Source='settings.launch', Converter={StaticResource KeyToText}}"/>
          <TextBlock Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"
                     Text="{Binding Source='settings.launch.desc', Converter={StaticResource KeyToText}}"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="崩溃自动修复策略" FontWeight="Bold" FontSize="14"/>
          <ComboBox ItemsSource="{Binding RepairPolicies}" SelectedItem="{Binding RepairPolicy}"/>

          <TextBlock Text="Java 路径" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBox Text="{Binding JavaPath}" Watermark="留空则自动检测"
                     Width="360" HorizontalAlignment="Left"
                     Background="{DynamicResource InputBackground}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <Button Classes="modal-btn accent" Content="自动检测" Command="{Binding AutoDetectJavaCommand}"/>
          </StackPanel>

          <TextBlock Text="额外 JVM 参数（空格分隔）" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <TextBox Text="{Binding ExtraJvmArgs}" Watermark="-XX:+UseZGC"
                   Background="{DynamicResource InputBackground}"
                   Foreground="{DynamicResource PrimaryForeground}"
                   BorderBrush="{DynamicResource InputBorder}"/>

          <TextBlock Text="内存分配（MB）" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <TextBox Grid.Column="0" Text="{Binding MinMemoryMb}" Watermark="最小值，如 512"
                     Background="{DynamicResource InputBackground}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <TextBox Grid.Column="1" Text="{Binding MaxMemoryMb}" Watermark="最大值，如 2048" Margin="8,0,0,0"
                     Background="{DynamicResource InputBackground}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
          </Grid>

          <TextBlock Text="默认用户名" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <TextBox Text="{Binding DefaultUsername}" Watermark="Player"
                   Background="{DynamicResource InputBackground}"
                   Foreground="{DynamicResource PrimaryForeground}"
                   BorderBrush="{DynamicResource InputBorder}"/>

          <TextBlock Text="自动安装 Java 的发行商" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <ComboBox ItemsSource="{Binding JavaVendors}" SelectedItem="{Binding JavaVendor}"/>

          <TextBlock Text="缺失 Mod 依赖自动安装" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <ComboBox ItemsSource="{Binding AutoInstallPolicies}" SelectedItem="{Binding AutoInstall}"/>

          <TextBlock Text="游戏目录" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBox Text="{Binding GameRoot}" Watermark="/home/用户/.minecraft"
                     Width="360" HorizontalAlignment="Left"
                     Background="{DynamicResource InputBackground}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <Button Name="BrowseBtn" Classes="modal-btn" Content="浏览…" Click="OnBrowseClick"/>
            <Button Name="OpenBtn" Classes="modal-btn" Content="打开" Click="OnOpenClick"/>
            <Button Name="ResetBtn" Classes="modal-btn" Content="恢复默认" Click="OnResetClick"/>
          </StackPanel>

          <TextBlock Text="启动前存档兼容性检测" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <ToggleSwitch IsChecked="{Binding LaunchCompatCheck}"/>

          <TextBlock Text="启动预热" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <ComboBox ItemsSource="{Binding PrewarmModes}" SelectedItem="{Binding PrewarmMode}"/>

          <TextBlock Text="游戏内 HUD 悬浮窗" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <ToggleSwitch IsChecked="{Binding HudEnabled}"/>

          <Button Classes="modal-btn accent" Content="保存" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <TextBlock Classes="status" Text="{Binding Status}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
