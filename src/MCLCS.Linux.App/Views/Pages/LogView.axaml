<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.LogView">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="刷新" Command="{Binding RefreshCommand}"/>
      <Button Content="导出" Command="{Binding ExportCommand}" Classes="modal-btn"/>
    </StackPanel>

    <ListBox Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}"
             Background="{DynamicResource InputBackground}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Margin="8,0" Padding="6,1" CornerRadius="6"
                    Background="{DynamicResource AccentBrush}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=crash}">
              <TextBlock Text="崩溃" FontSize="10" Foreground="#FFFFFF"/>
            </Border>
            <TextBlock Grid.Column="2" Text="{Binding SizeBytes}" FontSize="11"
                       Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="12,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <TextBox Width="200" Text="{Binding FilterText}" Watermark="过滤关键字（不区分大小写）"
                 VerticalAlignment="Center"/>
        <CheckBox Content="仅错误" IsChecked="{Binding OnlyErrors}" VerticalAlignment="Center"/>
        <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Lines}"
               Background="{DynamicResource InputBackground}"
               FontFamily="Consolas,Monospace" FontSize="12">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
