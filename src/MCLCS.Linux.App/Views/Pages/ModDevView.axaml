<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.ModDevView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                 Text="{Binding Source='tool.moddev', Converter={StaticResource KeyToText}}"/>
      <TextBlock Text="{Binding Source='tool.moddev.desc', Converter={StaticResource KeyToText}}"
                 Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>

      <StackPanel Spacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="Mod ID" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding ModId}" Watermark="examplemod"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="显示名称" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding ModName}" Watermark="Example Mod"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="加载器" Foreground="{DynamicResource SecondaryForeground}"/>
          <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}" MinWidth="160"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="目标 MC 版本" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding McVersion}" Watermark="1.21.1"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="目标目录" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding TargetDir}" Watermark="/home/user/dev"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="生成 Mod 骨架" Command="{Binding GenerateCommand}" Classes="modal-btn primary"
                IsEnabled="{Binding !Busy}"/>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryForeground}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
