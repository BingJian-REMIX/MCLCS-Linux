<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.ModpackIoView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">

      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="游戏目录" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding GameRoot}" Watermark="/home/user/.minecraft"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="版本 ID" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding VersionId}" Watermark="1.21.1"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="显示名称（可选）" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding DisplayName}" Watermark="我的整合包"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="导出路径 (.zip)" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding DestZip}" Watermark="/home/user/modpack.zip"/>
        </StackPanel>

        <StackPanel Spacing="6">
          <ToggleSwitch Content="Mods" IsChecked="{Binding IncludeMods}"/>
          <ToggleSwitch Content="Config" IsChecked="{Binding IncludeConfig}"/>
          <ToggleSwitch Content="材质包" IsChecked="{Binding IncludeResourcePacks}"/>
          <ToggleSwitch Content="光影包" IsChecked="{Binding IncludeShaderPacks}"/>
          <ToggleSwitch Content="存档" IsChecked="{Binding IncludeSaves}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="导出整合包" Command="{Binding ExportCommand}" Classes="modal-btn primary"
                  IsEnabled="{Binding !Busy}"/>
          <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                     Foreground="{DynamicResource SecondaryForeground}"/>
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
