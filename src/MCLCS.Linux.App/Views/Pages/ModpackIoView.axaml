<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.ModpackIoView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                 Text="{Binding Source='tool.modpackio', Converter={StaticResource KeyToText}}"/>
      <TextBlock Text="{Binding Source='tool.modpackio.desc', Converter={StaticResource KeyToText}}"
                 Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>

      <StackPanel Spacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="游戏目录" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding GameRoot}" Watermark="/home/user/.minecraft"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="版本 ID" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding VersionId}" Watermark="1.21.1"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="显示名称（可选）" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding DisplayName}" Watermark="我的整合包"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="导出路径 (.zip)" Foreground="{DynamicResource SecondaryForeground}"/>
          <TextBox Text="{Binding DestZip}" Watermark="/home/user/modpack.zip"/>
        </StackPanel>
      </StackPanel>

      <WrapPanel Orientation="Horizontal">
        <CheckBox Content="Mods" IsChecked="{Binding IncludeMods}"/>
        <CheckBox Content="Config" IsChecked="{Binding IncludeConfig}"/>
        <CheckBox Content="材质包" IsChecked="{Binding IncludeResourcePacks}"/>
        <CheckBox Content="光影包" IsChecked="{Binding IncludeShaderPacks}"/>
        <CheckBox Content="存档" IsChecked="{Binding IncludeSaves}"/>
      </WrapPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="导出整合包" Command="{Binding ExportCommand}" Classes="modal-btn primary"
                IsEnabled="{Binding !Busy}"/>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryForeground}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
