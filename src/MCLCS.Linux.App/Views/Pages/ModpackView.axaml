<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.ModpackView"
             x:DataType="vm:ModpackViewModel">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900">
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                     Text="{Binding Source='lbl.modpack', Converter={StaticResource KeyToText}}"/>
          <TextBlock Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"
                     Text="{Binding Source='lbl.modpack.desc', Converter={StaticResource KeyToText}}"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="安装整合包" FontWeight="Bold" FontSize="14"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding MrpackPath}" Watermark="本地 .mrpack 整合包路径"/>
            <Button Grid.Column="1" Classes="modal-btn accent" Content="安装" Command="{Binding InstallCommand}"
                    IsEnabled="{Binding !Busy}" Margin="8,0,0,0"/>
          </Grid>
          <CheckBox Content="隔离安装（独立目录）" IsChecked="{Binding Isolated}"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="导出整合包" FontWeight="Bold" FontSize="14"/>
          <TextBox Text="{Binding VersionId}" Watermark="要导出的 MC 版本号，如 1.21.4"/>
          <TextBox Text="{Binding DestZip}" Watermark="导出 zip 路径，如 /tmp/mypack.zip" Margin="0,8,0,0"/>
          <Button Classes="modal-btn" Content="导出" Command="{Binding ExportCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <ProgressBar IsIndeterminate="{Binding Busy}" IsVisible="{Binding Busy}"/>
        <TextBlock Grid.Column="1" Classes="status" Margin="12,0,0,0" Text="{Binding Status}"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
