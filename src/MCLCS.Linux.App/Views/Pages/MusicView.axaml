<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.MusicView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                 Text="{Binding Source='tool.music', Converter={StaticResource KeyToText}}"/>
      <TextBlock Text="{Binding Source='tool.music.desc', Converter={StaticResource KeyToText}}"
                 Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="AddFolderBtn" Content="添加音乐文件夹" Classes="modal-btn primary"/>
        <Button Content="播放" Command="{Binding PlayCommand}" Classes="modal-btn"/>
        <Button Content="暂停" Command="{Binding PauseCommand}" Classes="modal-btn"/>
        <Button Content="上一首" Command="{Binding PrevCommand}" Classes="modal-btn"/>
        <Button Content="下一首" Command="{Binding NextCommand}" Classes="modal-btn"/>
        <Button Content="切换模式" Command="{Binding CycleModeCommand}" Classes="modal-btn"/>
      </StackPanel>

      <TextBlock Text="{Binding CurrentTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
      <TextBlock Text="{Binding ModeText, StringFormat=模式：{0}}" Foreground="{DynamicResource SecondaryForeground}"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="音量" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
        <Slider Minimum="0" Maximum="100" Width="200" Value="{Binding Volume}"/>
        <TextBlock Text="{Binding Volume, StringFormat={}{0}}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryForeground}"/>
      </StackPanel>

      <ListBox ItemsSource="{Binding Tracks}" Background="{DynamicResource InputBackground}" MaxHeight="300">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" FontFamily="Consolas,Monospace" FontSize="12"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
