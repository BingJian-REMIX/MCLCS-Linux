<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.NbtView"
             x:DataType="vm:NbtViewModel">

  <Grid Margin="18" RowDefinitions="Auto,*,Auto">

    <!-- ===== 工具栏 ===== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,10">
      <TextBox Grid.Column="0" Text="{Binding FilePath}" Padding="6,3" VerticalContentAlignment="Center"
               Watermark=".dat / .nbt 文件路径（或从下方 level.dat 快捷打开）"
               Background="{DynamicResource InputBackground}"
               BorderBrush="{DynamicResource InputBorder}"/>
      <Button Grid.Column="1" Classes="modal-btn" Content="打开" Command="{Binding OpenCommand}"
              Width="64" Margin="6,0,0,0" Padding="0,3" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Classes="modal-btn primary" Content="保存" Command="{Binding SaveCommand}"
              Padding="14,4" Margin="6,0,0,0" VerticalAlignment="Center"/>
      <Button Grid.Column="3" Classes="modal-btn" Content="导出文本" Command="{Binding ExportTextCommand}"
              Width="80" Margin="6,0,0,0" Padding="0,3" VerticalAlignment="Center"/>
      <ToggleSwitch Grid.Column="4" IsChecked="{Binding AutoBackup}" Content="保存前自动备份"
                    Margin="14,0,0,0" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="5" ItemsSource="{Binding QuickFiles}" Width="220"
                Margin="14,0,8,0" VerticalAlignment="Center"
                SelectionChanged="QuickFile_SelectionChanged"
                ToolTip.Tip="存档的 level.dat 快捷入口"/>
      <TextBlock Grid.Column="6" Text="{Binding TitleText}" VerticalAlignment="Center"
                 FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
    </Grid>

    <!-- ===== 树 + 编辑区 ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="*,10,300">

      <Border Grid.Column="0" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="6">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6">
            <Button Classes="modal-btn" Content="全部展开" Command="{Binding ExpandAllCommand}"
                    Width="76" Padding="0,2"/>
            <Button Classes="modal-btn" Content="全部折叠" Command="{Binding CollapseAllCommand}"
                    Width="76" Padding="0,2"/>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
          </StackPanel>

          <TreeView Grid.Row="1" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}"
                    Background="Transparent" BorderThickness="0">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Background="{DynamicResource ControlBackground}" CornerRadius="3"
                          Padding="4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TypeText}" FontSize="10"
                               Foreground="{DynamicResource SecondaryForeground}"/>
                  </Border>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Text=" = " Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ValueText}" MaxWidth="320" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <!-- 右侧编辑面板 -->
      <Border Grid.Column="2" Background="{DynamicResource ControlBackground}"
              BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
              CornerRadius="8" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="选中节点" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,6"/>

            <TextBlock Text="路径" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBox Text="{Binding SelectedPath, Mode=OneWay}" IsReadOnly="True" Margin="0,2,0,6"
                     Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                     Padding="6,3" TextWrapping="Wrap"/>

            <TextBlock Text="类型" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBlock Text="{Binding SelectedTypeText}" Margin="0,2,0,8"
                       Foreground="{DynamicResource PrimaryForeground}"/>

            <TextBlock Text="值（仅标量可编辑）" FontSize="11"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBox Text="{Binding EditValue}" IsEnabled="{Binding CanEditValue}" Margin="0,2,0,6"
                     Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                     Padding="6,3" TextWrapping="Wrap"/>
            <Button Classes="modal-btn primary" Content="应用修改" Command="{Binding ApplyValueCommand}"
                    Padding="14,4" HorizontalAlignment="Left"/>

            <Border Height="1" Background="{DynamicResource ControlBorder}" Margin="0,12,0,8"/>

            <TextBlock Text="新增 / 重命名" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,6"/>
            <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBox Text="{Binding NewChildName}" Margin="0,2,0,6"
                     Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                     Padding="6,3"/>

            <TextBlock Text="类型" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
            <ComboBox ItemsSource="{Binding NewChildTypes}" SelectedItem="{Binding NewChildType}"
                      Margin="0,2,0,8" HorizontalAlignment="Left" Width="140"/>

            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="modal-btn" Content="新增子标签" Command="{Binding AddChildCommand}"
                      Width="94" Padding="0,3"/>
              <Button Classes="modal-btn" Content="重命名" Command="{Binding RenameCommand}"
                      Width="70" Padding="0,3"/>
            </StackPanel>

            <Button Classes="modal-btn" Content="删除选中标签" Command="{Binding RemoveCommand}"
                    Margin="0,10,0,0" Padding="0,4" HorizontalAlignment="Stretch"
                    Foreground="White" Background="{DynamicResource DangerBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0"
               Foreground="{DynamicResource StatusForeground}" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
