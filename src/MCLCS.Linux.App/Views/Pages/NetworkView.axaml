<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.NetworkView"
             x:DataType="vm:NetworkViewModel">
  <UserControl.Resources>
    <conv:BoolToBrushConverter x:Key="BoolToBrush"/>
    <conv:CountToVisibleConverter x:Key="CountToVisible"/>
  </UserControl.Resources>
  <ScrollViewer Margin="18">
    <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

      <Button Classes="modal-btn accent" Content="开始诊断" Command="{Binding DiagnoseCommand}"
              IsEnabled="{Binding !Busy}" HorizontalAlignment="Left"/>

      <StackPanel Spacing="8">
        <TextBlock Text="诊断结果" FontWeight="Bold" FontSize="14"/>
        <ItemsControl ItemsSource="{Binding Results}" IsVisible="{Binding Results.Count, Converter={StaticResource CountToVisible}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="10,8" Background="#1B1F2A" CornerRadius="6">
                <Grid ColumnDefinitions="12,*,Auto">
                  <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                           Fill="{Binding Reachable, Converter={StaticResource BoolToBrush}}"/>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                             Foreground="{DynamicResource SecondaryForeground}"
                             Text="{Binding LatencyMs, StringFormat='{}{0} ms'}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <ProgressBar IsIndeterminate="{Binding Busy}" IsVisible="{Binding Busy}"/>
        <TextBlock Grid.Column="1" Classes="status" Margin="12,0,0,0" Text="{Binding Status}"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
