<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.PerfView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding ToggleLabel}"
                Command="{Binding ToggleCommand}" Classes="modal-btn primary"/>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryForeground}"/>
      </StackPanel>

      <!-- 实时指标瓦片（对齐 WPF PerfView：圆角 6 / 内边距 12 / 实底）-->
      <WrapPanel Orientation="Horizontal">
        <Border Classes="tile" Width="160" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="CPU 占用" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding Cpu, StringFormat={}{0:F0}%}"/>
          </StackPanel>
        </Border>
        <Border Classes="tile" Width="160" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="内存占用" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding MemUsed, StringFormat={}{0:F0} MB}"/>
          </StackPanel>
        </Border>
        <Border Classes="tile" Width="160" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="FPS" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding Fps, StringFormat={}{0:F0}}"/>
          </StackPanel>
        </Border>
        <Border Classes="tile" Width="160" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="延迟" Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding Ping, StringFormat=已连接 {0} ms}"/>
          </StackPanel>
        </Border>
      </WrapPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
