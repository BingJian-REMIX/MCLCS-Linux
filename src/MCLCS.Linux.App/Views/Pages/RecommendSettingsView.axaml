<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.Linux.App.Converters"
             x:Class="MCLCS.Linux.App.Views.Pages.RecommendSettingsView"
             x:DataType="vm:RecommendSettingsViewModel">
  <UserControl.Resources>
    <conv:CountToVisibleConverter x:Key="CountToVisible"/>
  </UserControl.Resources>
  <ScrollViewer Margin="18">
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

      <StackPanel Spacing="8">
        <TextBlock Text="智能推荐模式" FontWeight="Bold" FontSize="14"/>
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
        <Button Classes="modal-btn accent" Content="保存" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="玩法分区偏好" FontWeight="Bold" FontSize="14"/>
        <TextBlock Foreground="{DynamicResource SecondaryForeground}" FontSize="12" TextWrapping="Wrap"
                   Text="勾选你感兴趣的分区，推荐结果将优先展示对应类别（引擎按此过滤）。"/>
        <ItemsControl ItemsSource="{Binding CategoryPreferences}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}"
                        Margin="0,4,16,4" VerticalContentAlignment="Center"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="计算推荐" FontWeight="Bold" FontSize="14"/>
        <Button Classes="modal-btn" Content="生成推荐" Command="{Binding BuildCommand}" IsEnabled="{Binding !Busy}"
                HorizontalAlignment="Left"/>
        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding Items.Count, Converter={StaticResource CountToVisible}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="10,8" Background="{DynamicResource CardBackground}" CornerRadius="6">
                <TextBlock Text="{Binding}"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <ProgressBar IsIndeterminate="{Binding Busy}" IsVisible="{Binding Busy}"/>
        <TextBlock Grid.Column="1" Classes="status" Margin="12,0,0,0" Text="{Binding Status}"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
