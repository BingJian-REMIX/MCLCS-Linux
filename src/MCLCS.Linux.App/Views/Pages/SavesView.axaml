<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MCLCS.Linux.App.ViewModels"
             xmlns:conv="using:MCLCS.Linux.App.Converters"
             xmlns:core="using:MCLCS.Core.Save"
             x:Class="MCLCS.Linux.App.Views.Pages.SavesView"
             x:DataType="vm:SavesViewModel">
  <UserControl.Resources>
    <conv:FileNameConverter x:Key="FileName"/>
    <conv:SaveSeverityToBrushConverter x:Key="SaveSeverityToBrush"/>
    <conv:CountToVisibleConverter x:Key="CountToVisible"/>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="28,22" Spacing="16">

      <DockPanel>
        <Button Classes="modal-btn" DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}"/>
        <Button Classes="modal-btn accent" DockPanel.Dock="Right" Margin="8,0,0,0" Content="分析全部存档"
                Command="{Binding AnalyzeCommand}"/>
        <TextBox Watermark="降级目标版本（如 1.21.4）" Text="{Binding TargetVersion}"
                 VerticalAlignment="Center" Width="200"/>
      </DockPanel>

      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Spacing="8" Margin="0,0,8,0">
          <TextBlock Text="存档列表" FontWeight="Bold" FontSize="14"/>
          <ListBox ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave, Mode=TwoWay}"
                   MaxHeight="320" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource FileName}}" FontSize="13"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="（选中存档后可执行 备份 / 删除 / 恢复 / 提取种子 / 降级）" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="8" Margin="8,0,0,0">
          <TextBlock Text="兼容性检测" FontWeight="Bold" FontSize="14"/>
          <TextBlock Text="（选一个存档后可执行快速降级）" FontSize="11" Foreground="{DynamicResource SecondaryForeground}" IsVisible="False"/>
          <ItemsControl ItemsSource="{Binding CompatReports}" IsVisible="{Binding CompatReports.Count, Converter={StaticResource CountToVisible}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:SaveCompatibilityReport">
                <Border Margin="0,0,0,6" Padding="8,6" Background="{DynamicResource CardBackground}" CornerRadius="6">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="9" Height="9" Fill="{Binding Severity, Converter={StaticResource SaveSeverityToBrush}}"/>
                      <TextBlock Text="{Binding SaveName}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SaveGameVersion}" Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="8" Margin="8,16,0,0">
          <TextBlock Text="损坏检测" FontWeight="Bold" FontSize="14"/>
          <ItemsControl ItemsSource="{Binding CorruptionReports}" IsVisible="{Binding CorruptionReports.Count, Converter={StaticResource CountToVisible}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:SaveCorruptionReport">
                <Border Margin="0,0,0,6" Padding="8,6" Background="{DynamicResource CardBackground}" CornerRadius="6">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="9" Height="9" Fill="{Binding Severity, Converter={StaticResource SaveSeverityToBrush}}"/>
                      <TextBlock Text="{Binding SaveName}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <DockPanel>
        <Button Classes="modal-btn danger" DockPanel.Dock="Right" Content="删除"
                Command="{Binding DeleteCommand}" IsEnabled="{Binding !Busy}"/>
        <Button Classes="modal-btn" DockPanel.Dock="Right" Margin="8,0,0,0" Content="恢复备份"
                Command="{Binding RestoreCommand}" IsEnabled="{Binding !Busy}"/>
        <Button Classes="modal-btn" DockPanel.Dock="Right" Margin="8,0,0,0" Content="备份"
                Command="{Binding BackupCommand}" IsEnabled="{Binding !Busy}"/>
        <Button Classes="modal-btn accent" DockPanel.Dock="Right" Margin="8,0,0,0" Content="提取种子"
                Command="{Binding ExtractSeedCommand}"/>
        <TextBlock Text="{Binding ActionResult}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryForeground}" FontSize="12"/>
      </DockPanel>

      <DockPanel>
        <Button Classes="modal-btn danger" DockPanel.Dock="Right"
                Content="快速降级（修改 DataVersion）" Command="{Binding DowngradeCommand}"
                IsEnabled="{Binding !Busy}"/>
        <TextBlock Text="{Binding DowngradeResult}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryForeground}" FontFamily="Consolas" FontSize="12"/>
      </DockPanel>

      <Grid ColumnDefinitions="*,Auto">
        <ProgressBar IsIndeterminate="{Binding Busy}" IsVisible="{Binding Busy}"/>
        <TextBlock Grid.Column="1" Classes="status" Margin="12,0,0,0" Text="{Binding Status}"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
