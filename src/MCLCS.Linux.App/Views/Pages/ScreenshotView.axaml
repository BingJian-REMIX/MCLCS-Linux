<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.ScreenshotView">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900">
      <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                 Text="{Binding Source='tool.screenshot', Converter={StaticResource KeyToText}}"/>

      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="刷新" Command="{Binding RefreshCommand}"/>
          <Button Content="删除选中" Command="{Binding DeleteCommand}" Classes="modal-btn danger"/>
          <Button Content="打包分享" Command="{Binding PackageCommand}" Classes="modal-btn primary"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}"/>
        <ListBox ItemsSource="{Binding Shots}" Background="{DynamicResource InputBackground}" MaxHeight="360">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                           FontFamily="Consolas,Monospace" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11"
                           Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding CreatedUtc}" FontSize="11"
                           Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
