<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.ShortcutView"
             x:DataType="vm:ShortcutViewModel">
  <ScrollViewer Margin="18">
    <StackPanel Spacing="14" MaxWidth="900">
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"
                     Text="{Binding Source='tool.shortcut', Converter={StaticResource KeyToText}}"/>
          <TextBlock Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"
                     Text="{Binding Source='tool.shortcut.desc', Converter={StaticResource KeyToText}}"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="版本号" FontWeight="Bold" FontSize="14"/>
          <TextBox Text="{Binding VersionId}" Watermark="例如 1.21.4"/>
          <TextBlock Text="桌面目录" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
          <TextBox Text="{Binding DesktopDir}"/>
          <Button Classes="modal-btn accent" Content="生成快捷方式" Command="{Binding CreateCommand}"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 Foreground="#B8C0CC"/>
      <TextBlock Classes="status" Text="{Binding Status}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
