<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MCLCS.Linux.App.ViewModels"
             x:Class="MCLCS.Linux.App.Views.Pages.VersionSettingsView"
             x:DataType="vm:VersionSettingsViewModel">
  <ScrollViewer MaxHeight="560">
    <StackPanel Spacing="14">

      <!-- ① 基础信息 -->
      <Border Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="基础信息" FontWeight="SemiBold" FontSize="14"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding VersionId}" FontWeight="Bold" FontSize="14"/>
              <TextBlock Text="{Binding VersionType, StringFormat='（{0}）'}" FontSize="11"
                         Foreground="{DynamicResource SecondaryForeground}"
                         IsVisible="{Binding VersionType, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="显示名" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayName}" Watermark="留空则使用版本号"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ④ 游戏目录 / 隔离 -->
      <Border Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="游戏目录与隔离" FontWeight="SemiBold" FontSize="14"/>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="隔离模式" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <ComboBox Grid.Column="1" SelectedValue="{Binding IsolationValue}"
                      SelectedValueBinding="{Binding Tag}" HorizontalAlignment="Left">
              <ComboBoxItem Content="共享（与 .minecraft 根目录共用）" Tag="Shared"/>
              <ComboBoxItem Content="自动隔离（versions/版本号 独立目录）" Tag="Auto"/>
              <ComboBoxItem Content="自定义目录（物理隔离）" Tag="Custom"/>
            </ComboBox>
            <TextBlock Grid.Column="0" Text="自定义目录" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"
                       IsVisible="{Binding IsCustomDir}"/>
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" IsVisible="{Binding IsCustomDir}">
              <TextBox Grid.Column="0" Text="{Binding CustomGameDir}" Watermark="/path/to/instance"/>
              <Button Grid.Column="1" Classes="modal-btn" Content="浏览" Margin="8,0,0,0"
                      Click="OnBrowseCustomDir"/>
            </Grid>
          </Grid>
          <TextBlock Text="{Binding EffectiveGameDirDisplay, StringFormat='有效工作目录：{0}'}"
                     FontSize="11" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ③ 模组加载器 -->
      <Border Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="模组加载器" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="{Binding DetectedLoaderText, StringFormat='当前：{0}'}" FontSize="12"
                     Foreground="{DynamicResource SecondaryForeground}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsVanilla}">
            <Button Classes="modal-btn" Content="安装 Fabric" Command="{Binding InstallLoaderCommand}" CommandParameter="fabric"/>
            <Button Classes="modal-btn" Content="安装 Forge" Command="{Binding InstallLoaderCommand}" CommandParameter="forge"/>
            <Button Classes="modal-btn" Content="安装 NeoForge" Command="{Binding InstallLoaderCommand}" CommandParameter="neoforge"/>
            <Button Classes="modal-btn" Content="安装 Quilt" Command="{Binding InstallLoaderCommand}" CommandParameter="quilt"/>
          </StackPanel>
          <TextBlock Text="安装会基于当前版本创建新的加载器实例，装完后请在版本列表切换到它。"
                     FontSize="11" Foreground="{DynamicResource SecondaryForeground}"
                     IsVisible="{Binding IsVanilla}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ⑤ Java 与性能 -->
      <Border Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="Java 与性能" FontWeight="SemiBold" FontSize="14"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Java 路径" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding JavaPath}" Watermark="留空使用全局设置" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="最大内存" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxMemoryMb}" Minimum="512" Maximum="65536"
                           Increment="256" Width="200" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="最小内存" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MinMemoryMb}" Minimum="256" Maximum="65536"
                           Increment="256" Width="200" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="额外 JVM 参数" VerticalAlignment="Top"
                       Foreground="{DynamicResource SecondaryForeground}" Margin="0,6,0,0"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ExtraJvmArgsText}" Height="60" AcceptsReturn="True"
                     Watermark="每行一个，如 -XX:+UseZGC"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ⑥ 分辨率与窗口 -->
      <Border Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="分辨率与窗口" FontWeight="SemiBold" FontSize="14"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="宽" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
              <NumericUpDown Value="{Binding ResolutionWidth}" Minimum="0" Maximum="7680" Increment="1" Width="110"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="高" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
              <NumericUpDown Value="{Binding ResolutionHeight}" Minimum="0" Maximum="4320" Increment="1" Width="110"/>
            </StackPanel>
            <TextBlock Text="（0 = 使用全局 / 窗口化）" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SecondaryForeground}"/>
          </StackPanel>
          <ToggleSwitch IsChecked="{Binding Fullscreen}" Content="全屏启动" HorizontalAlignment="Left" OffContent="" OnContent=""/>
        </StackPanel>
      </Border>

      <!-- ⑦ 模组 / 资源包 / 光影管理 -->
      <Border Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="模组与资源包管理" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" SelectedValue="{Binding ModTabValue}"
                      SelectedValueBinding="{Binding Tag}" HorizontalAlignment="Right" Width="140">
              <ComboBoxItem Content="Mods" Tag="Mods"/>
              <ComboBoxItem Content="资源包" Tag="ResourcePacks"/>
              <ComboBoxItem Content="光影" Tag="Shaders"/>
            </ComboBox>
          </Grid>

          <!-- 已安装 -->
          <TextBlock Text="已安装" FontSize="12" Foreground="{DynamicResource SecondaryForeground}"/>
          <ItemsControl ItemsSource="{Binding InstalledItems}" MaxHeight="160">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InstalledItemViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="modal-btn" Content="移除" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding FileName}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="modal-btn" Content="打开文件夹" Command="{Binding OpenFolderCommand}"/>
            <Button Classes="modal-btn" Content="刷新" Command="{Binding RefreshModsCommand}"/>
            <Button Classes="modal-btn" Content="检查更新" Command="{Binding CheckUpdatesCommand}"
                    IsVisible="{Binding IsModsTab}"/>
          </StackPanel>

          <!-- 添加（Modrinth 搜索） -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <TextBox Grid.Column="0" Text="{Binding SearchQuery}" Watermark="搜索 Modrinth（名称 / 关键词）"/>
            <Button Grid.Column="1" Classes="modal-btn primary" Content="搜索" Margin="8,0,0,0"
                    Command="{Binding SearchModsCommand}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding SearchResults}" MaxHeight="160">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModSearchHit">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Classes="modal-btn" Content="添加" Command="{Binding DataContext.AddModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ⑧ 版本锁定 -->
      <Border Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="8">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="版本锁定" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="锁定后阻止自动更新覆盖该版本。" FontSize="11"
                       Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding Locked}" OffContent="" OnContent=""/>
        </Grid>
      </Border>

      <!-- 状态 -->
      <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"
                 IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
